{
  "expo": {
    "name": "Breeze",
    "slug": "breeze",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.m3xi.breeze",
      "infoPlist": {
        "NSCameraUsageDescription": "Breeze uses the camera to scan food barcodes and product labels."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5BB3EA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.m3xi.breeze",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Breeze uses the camera to scan food barcodes and product labels."
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "scheme": "breeze",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EEF6FC"
    }
  }
}

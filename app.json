{
  "expo": {
    "name": "Tide",
    "slug": "tide-fitness",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tide.fitness",
      "infoPlist": {
        "NSCameraUsageDescription": "Tide uses the camera to scan food barcodes and product labels."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A6CFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tide.fitness",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Tide uses the camera to scan food barcodes and product labels."
        }
      ]
    ],
    "scheme": "tide",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F2F5FA"
    }
  }
}

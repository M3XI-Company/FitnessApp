# Copy to .env and fill in to enable "Snap your meal" (food photo scanning) and the AI coach (docs/AI_COACH.md).
# Both values come from your Supabase project (Settings → API). The anon key is public by design.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
